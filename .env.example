# Flock Together — example environment
#
# Copy this file to `.env` and edit. Every value below is OPTIONAL: the game runs
# with none of them set. `.env` is gitignored; this example file is not.
#
# IMPORTANT: nothing in this project reads `.env` automatically — there is no
# dotenv dependency. Load it one of these ways:
#
#   node --env-file=.env server.js        # Node 20.6+, the simplest option
#   PUBLIC_URL=https://… npm start        # one-off inline (macOS / Linux)
#   $env:PUBLIC_URL = "https://…"         # one-off (Windows PowerShell)
#   npm start
#
# The authoritative list of variables and defaults is src/config.js. Values that
# are not numbers where a number is expected fall back to the default with a
# warning rather than crashing the server.
#
# Verify your setup before a party:  node tools/preflight.js


# ─── Semantic grouping (the mechanism the game is built on) ──────────────────

# Server-side API key for the Claude call that clusters answers by MEANING, so
# "soda", "pop" and "a coke" land in one group. Model: claude-opus-5.
# The key is used only on the server and is never sent to a browser.
#
# WITHOUT IT THE GAME STILL RUNS. Grouping degrades to deterministic fuzzy text
# matching (normalise, strip punctuation, near-match) and the display honestly
# reports which method was used via `groupingSource: 'claude' | 'fallback'`.
# Fuzzy matching will miss synonyms — that is the trade, not a crash.
ANTHROPIC_API_KEY=sk-ant-...

# Alternative credential accepted in place of ANTHROPIC_API_KEY (the SDK's OAuth
# / gateway token). Set ONE of the two, not both. Leave commented out normally.
# ANTHROPIC_AUTH_TOKEN=


# ─── Transport ───────────────────────────────────────────────────────────────

# Port for both HTTP and the /socket WebSocket. Default: 3000.
# The display is then at http://localhost:<PORT>/ and players at /play.
PORT=3000

# THE ONE MOST LIKELY TO TRIP YOU UP. Origin that the QR code and the printed
# join URL point at. Default: unset.
#
# Unset, the server guesses: first non-internal IPv4 of this machine (e.g.
# http://192.168.1.24:3000), then http://localhost:<PORT>. That is correct for a
# co-located party on one Wi-Fi network and USELESS for remote play — if you are
# screensharing the display over Zoom / Discord / Meet, the QR encodes a LAN
# address the remote players' phones cannot reach, and they simply cannot join.
#
# So whenever the game is reachable at some other origin — a tunnel, a deploy, a
# reverse proxy — set this to that origin:
#
#   PUBLIC_URL=https://your-tunnel.example.com     # cloudflared / ngrok / tailscale funnel
#   PUBLIC_URL=https://flock.example.com           # deployed behind a proxy
#
# Include the scheme. Include the port only if non-standard. Do NOT add a path —
# the server appends /play?room=ABCD itself. A trailing slash is trimmed.
# PUBLIC_URL=


# ─── Timings ─────────────────────────────────────────────────────────────────

# Seconds players have to submit before submissions close and the reveal starts.
# Default: 45. Lower for a brisk game; raise for a tipsy or distracted room.
# Answer text is never sent to any client while this timer runs.
ANSWER_SECONDS=45

# Milliseconds the reveal holds on screen before the round auto-advances.
# Default: 9000. The reveal IS the entertainment — the room needs time to shout
# at the groups. Do not cut this below about 6000. Rounds auto-advance; there is
# no host "next" button anywhere, so this value alone paces the show.
REVEAL_MS=9000

# Milliseconds a scoreboard holds on screen. Default: 8000.
# Scores appear at exactly three moments (one third in, before the final
# question, and at the end), so this is shown three times per game.
SCORES_MS=8000


# ─── Room shape ──────────────────────────────────────────────────────────────

# Players who must have joined before the display can start the game.
# Default: 2. A majority game is thin below about 5 real players.
LOBBY_MIN_PLAYERS=2

# Hard cap on players per room; further joins are rejected with ROOM_FULL.
# Default: 20. The reveal layout is designed for 10–20 answers, up to ~8 groups.
MAX_PLAYERS=20

# Questions per game. Default: 9. Also decides where the two mid-game
# scoreboards fall (one third of the way through, and before the last question).
DEFAULT_ROUNDS=9
